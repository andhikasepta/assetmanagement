# ── Version Control ─────────────────────────────────────────
.git/
.git/**
.gitignore
.gitattributes

# ── Environment & Secrets ──────────────────────────────────
.env
.env.*
!.env.example

# ── Dependencies (Built inside container via Composer) ───────
vendor/
node_modules/
composer.phar

# ── Logs & Runtime Cache ────────────────────────────────────
*.log
**/*.log
logs/
**/logs/
cache/
**/cache/
tmp/
**/tmp/
temp/
**/temp/
*.tmp
*.temp

# ── Uploads & User Generated Content ─────────────────────────
uploads/*
!uploads/.gitkeep
!uploads/.htaccess

# ── Scratch, Tests, Debug & Inspect Scripts ─────────────────
scratch/*
!scratch/.gitkeep
tests/
**/tests/
test_*.php
inspect_*.php
check_*.php
benchmark_*.php
*.out

# ── Backups, Archives & Database Dumps ───────────────────────
*.sql
*.dump
*.sqlite
*.bak
*.old
*.swp
*~
*.tar
*.tar.gz
*.tgz
*.zip
*.rar
*.7z
*.csv
*.xlsx
*.xls

# ── AI, IDE & OS Metadata ───────────────────────────────────
.agents/
.agents/**
.gemini/
.gemini/**
.idea/
.vscode/
.fleet/
.DS_Store
**/.DS_Store
Thumbs.db
**/Thumbs.db
ehthumbs.db
desktop.ini
*.sublime-*

# ── Deployment & Docker Configs (not needed in web root) ─────
Dockerfile
docker-compose*.yml
.dockerignore
deployment/

# ── Documentation & Text Files ──────────────────────────────
*.md
**/*.md
*.txt
